{
  "id": "generic.developer",
  "name": "通用开发者包",
  "version": 1,
  "description": "开发者基于模板、命令和自定义 Facade 组合自己的设备能力。",
  "templates": [
    {
      "id": "generic.serial",
      "version": 1,
      "name": "通用串口设备",
      "description": "适用于 AT/文本命令型设备的安全只读模板。",
      "connectionTypes": ["serial"],
      "permissions": { "defaultMode": "read-only", "allowWrite": false },
      "commands": [
        { "id": "help", "label": "帮助", "text": "help", "lineEnding": "CRLF", "risk": "read" },
        { "id": "version", "label": "版本", "text": "version", "lineEnding": "CRLF", "risk": "read" }
      ],
      "logEvents": [
        { "id": "error", "level": "error", "pattern": "\\b(error|fail(ed)?)\\b", "summary": "设备报告错误" },
        { "id": "timeout", "level": "warning", "pattern": "\\btimeout\\b", "summary": "设备或网络超时" }
      ]
    }
  ],
  "components": [
    { "id": "project-templates", "type": "template-dir", "path": "templates", "description": "项目内设备模板目录" },
    { "id": "device-resources", "type": "resource-dir", "path": "resources", "description": "设备资料、寄存器表、协议说明" },
    { "id": "device-scripts", "type": "script-dir", "path": "scripts", "description": "开发者维护的辅助脚本" },
    { "id": "log-parser", "type": "parser", "path": "parsers/log-parser.mjs", "description": "自定义日志解析器", "risk": "read" },
    { "id": "device-tool", "type": "tool", "path": "tools/device-tool.mjs", "description": "自定义 MCP 工具", "risk": "read" }
  ]
}
