# pnpm 使用 npm 兼容的扁平 node_modules（hoisted）：
# - electron-builder install-app-deps / electron 打包对 symlink 结构兼容性风险归零（计划 §7.1 R7）
# - 现有 npm 脚本、postinstall 行为零变化
node-linker=hoisted
# Electron 二进制不走 GitHub 下载（此前网络超时），安装后从父机缓存/现有 node_modules 复用
# 若全新机器安装，请删除下行并配置 ELECTRON_MIRROR 镜像
electron_skip_binary_download=true
