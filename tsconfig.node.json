{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "apps/superconnectx/electron.vite.config.*",
    "apps/superconnectx/src/main/**/*",
    "apps/superconnectx/src/preload/**/*",
    "apps/superconnectx/src/core/**/*",
    "apps/superconnectx/src/shared/**/*",
    "packages/foundation/src/main/**/*",
    "packages/superconnectx-mcp/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@superx/foundation/*": [
        "packages/foundation/src/*"
      ],
      "@superx/mcp": ["packages/superconnectx-mcp/src/index.ts"],
      "@superx/mcp/*": ["packages/superconnectx-mcp/src/*"]
    }
  }
}
