{
  "name": "superconnectx",
  "version": "1.2.9",
  "description": "SuperConnectX - 超级连接",
  "main": "./apps/superconnectx/out/main/index.js",
  "author": "SuperStudio",
  "homepage": "https://github.com/SuperStudio/SuperConnectX",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "test:all": "npm test && npm run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install",
    "start": "electron-vite preview --config apps/superconnectx/electron.vite.config.ts",
    "dev": "electron-vite dev --config apps/superconnectx/electron.vite.config.ts",
    "build": "npm run typecheck && electron-vite build --config apps/superconnectx/electron.vite.config.ts && electron-builder",
    "postinstall": "node scripts/rebuild-native.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run typecheck && electron-vite build --config apps/superconnectx/electron.vite.config.ts && electron-builder --win",
    "build:mac": "electron-vite build --config apps/superconnectx/electron.vite.config.ts && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@serialport/parser-readline": "^13.0.0",
    "adm-zip": "^0.5.18",
    "archiver": "^7.0.1",
    "buffer": "^6.0.3",
    "builder-util-runtime": "^9.7.0",
    "crc": "^4.3.2",
    "electron-store": "^3.3.0",
    "electron-updater": "^6.6.2",
    "element-plus": "^2.11.9",
    "ftp-srv": "^4.6.3",
    "iconv-lite": "^0.7.3",
    "monaco-editor": "^0.55.1",
    "serialport": "^13.0.0",
    "sortablejs": "^1.15.7",
    "ssh2": "^1.17.0",
    "telnet-client": "^2.2.9",
    "vue-i18n": "^11.4.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron/rebuild": "^3.6.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/electron-store": "^1.3.1",
    "@types/node": "^22.18.6",
    "@types/sortablejs": "^1.15.9",
    "@types/ssh2": "^1.15.5",
    "@types/winston": "^2.4.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.6",
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.6",
    "vue": "^3.5.21",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
