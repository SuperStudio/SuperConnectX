{
  "name": "@superx/template-app",
  "version": "0.1.0",
  "description": "A minimal Electron + Vue 3 desktop app template consuming @superx/foundation via pnpm workspace (no copied sources).",
  "main": "out/main/index.js",
  "author": "SuperStudio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check:paths": "node _check_paths.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@superx/foundation": "workspace:*",
    "@superx/shared": "workspace:*",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "element-plus": "^2.7.0",
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^38.8.6",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
