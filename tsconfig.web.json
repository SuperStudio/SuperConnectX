{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "packages/shared/src/**/*",
    "packages/foundation/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@superx/shared/*": [
        "packages/shared/src/*"
      ],
      "@superx/foundation/*": [
        "packages/foundation/src/*"
      ]
    }
  }
}
